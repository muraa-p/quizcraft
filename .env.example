# Supabase project settings (Project Settings -> API in your Supabase dashboard)
# 1. Create a free project at https://supabase.com/
# 2. Open Project Settings -> API and copy the Project URL and anon public key below
# 3. In Supabase SQL Editor, run: supabase/schema.sql
# 4. (Recommended) In Supabase Authentication -> URL Configuration, set Site URL and Redirect URLs for your app
# 5. Copy this file to .env.local (or .env), fill values, then restart: npm run dev

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Optional: site URL used for auth redirects/callbacks
# For local development keep: http://localhost:3000
# For production set to your deployed URL (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
